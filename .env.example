# ─── StudyMate AI — variables d'environnement (exemple, sans secrets réels) ───
# Copiez ce fichier en .env puis remplacez les valeurs « change-me ».
# Générer un secret : openssl rand -base64 48

# Base de données
POSTGRES_USER=studymate
POSTGRES_PASSWORD=change-me-db-password
POSTGRES_DB=studymate

# Stockage objet compatible S3 (MinIO en développement, S3 en production)
S3_ACCESS_KEY_ID=studymate
S3_SECRET_ACCESS_KEY=change-me-storage-secret
S3_BUCKET=studymate-documents

# Authentification (au moins 32 caractères chacun)
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters
FILE_TOKEN_SECRET=change-me-file-token-secret-at-least-32-chars
# true derrière HTTPS (production)
COOKIE_SECURE=false

# URLs publiques
PUBLIC_WEB_URL=http://localhost:8088
CORS_ORIGINS=http://localhost:8088,http://localhost:5173

# IA : « mock » (adaptateur de démonstration, sans modèle de langage) ou « anthropic »
AI_PROVIDER=mock
AI_MODEL=claude-opus-5-5
AI_EFFORT=medium
ANTHROPIC_API_KEY=
AI_DAILY_REQUEST_LIMIT=60

# Divers
MAX_UPLOAD_MB=25
LOG_LEVEL=info
