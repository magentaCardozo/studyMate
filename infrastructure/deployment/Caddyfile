# Certificat HTTPS obtenu et renouvelé automatiquement (Let's Encrypt).
{$DOMAIN} {
	encode gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}
	# Application Android de test, téléchargeable depuis le téléphone.
	handle_path /telecharger/* {
		root * /srv/downloads
		# Manifeste de mise à jour : toujours relu (jamais servi depuis un cache).
		@manifest path /version.json
		header @manifest Cache-Control "no-cache"
		@apk path *.apk
		header @apk Content-Disposition attachment
		file_server
	}
	handle {
		reverse_proxy web:80
	}
}
